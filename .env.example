# ── Nebius credentials ────────────────────────────────────────────────────
# Project ID (parent-id for endpoint creation).
# Leave blank to use the default from your CLI profile.
NEBIUS_PROJECT_ID=

# Named CLI profile to use (optional, uses default if unset).
NEBIUS_PROFILE=

# ── Model weights ─────────────────────────────────────────────────────────
# Required for gated HuggingFace models (LLaMA 4, etc.).
HUGGING_FACE_HUB_TOKEN=

# ── Benchmark API key override ────────────────────────────────────────────
# If the endpoint was created with --auth token, the token is read
# automatically from the endpoint status.  Set this only if you are
# pointing the tool at an existing endpoint created outside the app.
NEBIUS_API_KEY=
